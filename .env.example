# ============================================================
# POS APP — Environment Variables
# Salin file ini menjadi `.env` dan isi nilainya.
# JANGAN pernah commit file `.env`.
# ============================================================

# ---------- Backend (backend/.env) ----------
# Mode aplikasi
NODE_ENV=development

# Port server Express (development)
PORT=3001

# Supabase (project settings → API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SERVICE ROLE KEY — RAHASIA. HANYA dipakai di server/backend, JANGAN pernah di frontend!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT untuk session custom (username + password)
# Generate: openssl rand -hex 64
JWT_SECRET=ganti-dengan-random-string-panjang
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d

# Asal (origin) yang diizinkan untuk CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ---------- Notifikasi ke HP Owner (opsional) ----------
# Web Push (PWA) — generate: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY juga harus disalin ke frontend/.env sebagai VITE_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Fallback Telegram Bot — opsional (buat bot via @BotFather, isi chat id owner)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Frontend (frontend/.env) ----------
# Kunci publik VAPID (sama dengan VAPID_PUBLIC_KEY di atas) untuk Web Push dari browser
VITE_VAPID_PUBLIC_KEY=
# Base URL API. Kosongkan jika API satu domain dengan frontend (Vercel rewrite /api).
# Development memakai proxy Vite (lihat frontend/vite.config.js), jadi boleh kosong.
VITE_API_BASE_URL=
